# Backend Environment Variables
# Copy this file to .env and fill in the values

# MongoDB Connection
MONGO_URL="mongodb://localhost:27017"
DB_NAME="your_database_name"

# CORS Settings
CORS_ORIGINS="*"

# Frontend URL for generating public URLs
FRONTEND_URL=https://your-domain.com

# Admin Authentication
# Option 1: Multiple passwords (pipe-separated)
# ADMIN_PASSWORDS="password1|password2|password3"

# Option 2: Single password (fallback if ADMIN_PASSWORDS not set)
# ADMIN_PASSWORD="your_single_password"

# Note: If neither is set, default fallback is "inverser2024" (for development only)
